<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tone_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toneName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/pickTone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pick_tone"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.75"
            android:text="@string/tone_info" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/backup_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.75"
            android:text="@string/backup_info" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/backupSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/backup_switch"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/backupOffset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/offset0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offset_0" />

            <RadioButton
                android:id="@+id/offset5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offset_5" />

            <RadioButton
                android:id="@+id/offset10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offset_10" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
